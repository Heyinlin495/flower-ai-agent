# ================================
# 花卉识别 AI Agent 环境配置文件
# ================================

# 阿里云百炼大模型平台 - Anthropic 兼容接口
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=flower-ai-images
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou

# 向量数据库配置
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# 模型配置
LLM_MODEL_NAME=qwen-plus
VISION_MODEL_NAME=qwen-vl-max
EMBEDDING_MODEL_NAME=text-embedding-v3

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# 后端 worker 进程数：多人同时访问不排队（一个等 LLM 回复时其他请求由别的 worker 处理）。
# 生产服务器建议 2~4（约为 CPU 核数）；Windows / 调试模式自动强制为 1。
APP_WORKERS=2

# API 访问令牌（生产必填！为空时后端 /api/* 无鉴权，公网会被任意调用/烧额度/删知识库）
# 前端 Docker 容器自动读取同值（docker-compose 已映射 FLOWER_API_TOKEN）
API_TOKEN=
